    { "prefix": "ghu_", "provider": "github-user-to-server", "length": 40, "charset": "A-Za-z0-9" },
    { "prefix": "ghs_", "provider": "github-server-to-server", "length": 40, "charset": "A-Za-z0-9" },
    { "prefix": "ghr_", "provider": "github-refresh", "length": 40, "charset": "A-Za-z0-9" },
    { "prefix": "github_pat_", "provider": "github-fine-grained-pat", "minLength": 82, "maxLength": 100, "charset": "A-Za-z0-9_" },
    { "prefix": "xoxb-", "provider": "slack-bot", "minLength": 30, "maxLength": 120, "charset": "A-Za-z0-9-" },
