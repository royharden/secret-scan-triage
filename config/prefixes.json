    { "prefix": "ABIA", "provider": "aws-sts-service-bearer-key-id", "length": 20, "charset": "A-Z0-9" },
    { "prefix": "ACCA", "provider": "aws-context-specific-key-id", "length": 20, "charset": "A-Z0-9" },
    { "prefix": "ghp_", "provider": "github-classic-pat", "length": 40, "charset": "A-Za-z0-9" },
