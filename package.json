{
  "name": "secret-scan-triage",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Secret-scan false-positive triager: deterministic signals plus an optional masked judge, with an honest scorer.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "eval": "tsx scripts/eval.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.50.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.30.1",
    "@types/node": "24.0.10",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.6.0",
    "eslint": "9.30.1",
    "fake-indexeddb": "6.0.1",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.1",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
